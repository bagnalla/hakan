# EXPECT: OK
# EXPECT-JS-OUT: 1
# EXPECT-C-OUT: 1

class a is Eq
  | eq : a -> a -> Bool

instance Int is Eq
  | eq = λx. λy. x = y

data Box =
  | Box Int
  | Empty

pure matches : Int -> Box -> Bool
def matches = λtarget. λb.
  destruct b as
  | Box x -> eq x target
  | Empty -> false

run if matches 3 (Box 3) then 1 else 0
